{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ongsave",
  // Eduardofonseca1401@gmail.com's Account. Nunca publique o ONGSave em outra conta.
  "account_id": "51f772f7656a812951d1ee9ce5c3f9c0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Mantém /offline.html e demais arquivos de public/ com o caminho exato (o service worker depende disso).
    "html_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ongsave-db",
      "database_id": "00fa9a8f-288f-4f62-9e54-1bf371087c75",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // Bucket privado: sem domínio público nem r2.dev. Fotos saem só por /api/photos.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ongsave-photos" }],
  "vars": {
    "AI_MODE": "demo",
    "BETTER_AUTH_URL": "https://ongsave.eduardofonseca1401.workers.dev",
    "ENABLE_DEMO_MODE": "true",
    "NEXT_PUBLIC_MAP_PROVIDER": "maplibre",
  },
}
