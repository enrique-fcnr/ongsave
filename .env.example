# Referência das variáveis do ONGSave na Cloudflare.
# Não secretas: `vars` no wrangler.jsonc. Segredos: `npx wrangler secret put <NOME>`.
# Local: copie .dev.vars.example para .dev.vars. NEXT_PUBLIC_APP_URL de produção está em .env.production.
NEXT_PUBLIC_APP_URL=http://localhost:8787
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=
AI_MODE=demo
AI_PROVIDER=workers-ai
OPENAI_API_KEY=
AI_MODEL=
NEXT_PUBLIC_MAP_PROVIDER=maplibre
# Opcional: substitui o mapa vetorial ONGSave por tiles raster de outro provider.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=
ENABLE_DEMO_MODE=true
